{
  "name": "capix-cli",
  "version": "0.1.0",
  "description": "CLI for the Capix framework",
  "type": "module",
  "bin": {
    "capix": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "capix": "workspace:*",
    "capix-transport-rest": "workspace:*",
    "commander": "^12.0.0",
    "picocolors": "^1.1.0",
    "tsx": "^4.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0"
  }
}

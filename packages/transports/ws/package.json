{
  "name": "@capixjs/transport-ws",
  "version": "0.1.0-alpha.23",
  "description": "Capix WebSocket transport",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {

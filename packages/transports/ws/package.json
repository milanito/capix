  },
  "peerDependencies": {
    "@capixjs/core": ">=0.1.0-0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0",
    "zod": "^4.0.0",
    "@capixjs/core": "workspace:*"
  }

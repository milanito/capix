{
  "name": "@capixjs/transport-graphql",
  "version": "1.0.0",
  "description": "Capix GraphQL transport",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/milanito/capix.git",
    "directory": "packages/transports/graphql"
  },
  "homepage": "https://github.com/milanito/capix#readme",
  "bugs": {
    "url": "https://github.com/milanito/capix/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {

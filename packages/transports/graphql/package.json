  "dependencies": {
    "graphql": "^16.0.0",
    "graphql-http": "^1.22.0"
  },
  "peerDependencies": {
    "@capixjs/core": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.7",
    "zod": "^4.0.0",
    "@capixjs/core": "workspace:*"
  }

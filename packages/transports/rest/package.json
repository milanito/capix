{
  "name": "@capixjs/transport-rest",
  "version": "0.1.0-beta.3",
  "description": "Capix HTTP/REST transport",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/milanito/capix.git",
    "directory": "packages/transports/rest"
  },
  "homepage": "https://github.com/milanito/capix#readme",
  "bugs": {
    "url": "https://github.com/milanito/capix/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {

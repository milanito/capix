  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "fast-json-stringify": "^6.4.0",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@capixjs/core": ">=0.1.0-0"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.0",
    "@types/form-data": "^2.5.2",
    "@types/node": "^20.0.0",
    "form-data": "^4.0.5",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0",
    "@capixjs/core": "workspace:*"
  }

{
  "name": "@capixjs/store-redis",
  "version": "0.1.0-alpha.24",
  "description": "Redis-backed cache and rate-limit stores for Capix enhancers",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "LICENSE"
  ],
  "keywords": [
    "capix",
    "redis",
    "cache",
    "rate-limit",
    "store"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@capixjs/core": ">=0.1.0-0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0",
    "@capixjs/core": "workspace:*",
    "zod": "^4.0.0"
  }
}

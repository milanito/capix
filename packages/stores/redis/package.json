  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@capixjs/core": ">=0.1.0-0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.7",
    "@capixjs/core": "workspace:*",
    "zod": "^4.0.0"
  }

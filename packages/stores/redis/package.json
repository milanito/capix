{
  "name": "@capixjs/store-redis",
  "version": "0.1.0-beta.3",
  "description": "Redis-backed cache, rate-limit stores, and pub/sub event bus for Capix",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/milanito/capix.git",
    "directory": "packages/stores/redis"
  },
  "homepage": "https://github.com/milanito/capix#readme",
  "bugs": {
    "url": "https://github.com/milanito/capix/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "LICENSE"
  ],
  "keywords": [

{
  "name": "capix-plugin-logging",
  "version": "0.1.0-alpha.1",
  "description": "Structured request logging plugin for Capix using pino",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "keywords": [
    "capix",
    "logging",
    "pino",
    "plugin",
    "observability",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pino": "^9.0.0"
  },
  "peerDependencies": {
    "capix": ">=0.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "capix": "workspace:*",
    "typescript": "^5.5.0"
  }
}

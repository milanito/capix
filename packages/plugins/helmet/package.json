  "peerDependencies": {
    "@capixjs/transport-rest": ">=0.1.0-0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0",
    "@capixjs/transport-rest": "workspace:*",
    "vitest": "^3.2.7"
  }

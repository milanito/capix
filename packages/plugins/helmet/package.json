{
  "name": "@capixjs/plugin-helmet",
  "version": "0.1.0-beta.3",
  "description": "Security headers plugin for Capix",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/milanito/capix.git",
    "directory": "packages/plugins/helmet"
  },
  "homepage": "https://github.com/milanito/capix#readme",
  "bugs": {
    "url": "https://github.com/milanito/capix/issues"
  },
  "type": "module",
  "main": "./dist/index.js",

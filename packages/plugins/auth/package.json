{
  "name": "@capixjs/plugin-auth",
  "version": "0.1.0-alpha.2",
  "description": "JWT authentication plugin for Capix",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "LICENSE"
  ],
  "keywords": [
    "capix",
    "auth",
    "jwt",
    "authentication",
    "plugin",
    "security",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.0"
  },
  "peerDependencies": {
    "@capixjs/core": ">=0.1.0-0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.1",
    "@capixjs/core": "workspace:*"
  }
}

{
  "name": "@capixjs/testing",
  "version": "0.1.0-beta.1",
  "description": "Capix testing utilities",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/milanito/capix.git",
    "directory": "packages/testing"
  },
  "homepage": "https://github.com/milanito/capix#readme",
  "bugs": {
    "url": "https://github.com/milanito/capix/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "LICENSE"
  ],
  "keywords": [
    "capix",
    "testing",
    "test",
    "utilities",
    "vitest",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@capixjs/core": ">=0.1.0-0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0",
    "@capixjs/core": "workspace:*"
  }
}
